{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "jsx": "react-jsx",
    "isolatedModules": false,
    "esModuleInterop": true,
    "allowJs": true
  },
  "include": ["express/**/*"],
  "exclude": ["src/**/*"]
}
